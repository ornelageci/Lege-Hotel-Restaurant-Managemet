# Copy this file to ".env" and fill in the values. The ".env" file must NEVER be uploaded to GitHub.

# --- Required in production ---
# Secret key for sessions (min. 32 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- First accounts (only used while there are no users at all) ---
# The manager account. After the first sign-in, change the password and remove ADMIN_PASSWORD from this file.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional: also create a receptionist account at the same time.
RECEPTIONIST_EMAIL=
RECEPTIONIST_PASSWORD=

# --- Email notifications for new reservations (optional) ---
# Without SMTP_HOST nothing is sent; the reservation still works and the attempt is logged as "not sent".
# Example for Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com, SMTP_PASS=<an "app password">
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (implicit TLS), false for 587 (STARTTLS). Default: true only when the port is 465.
# SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Sender address shown to the recipient. Defaults to SMTP_USER.
# MAIL_FROM="Hotel Lege <reservations@lege.al>"
# Who is told about every new reservation, comma-separated. Leave empty to notify all managers.
# NOTIFY_EMAILS=owner@lege.al,manager@lege.al

# --- Separate frontend (optional) ---
# Addresses allowed to call the API, comma-separated (no trailing "/", no "*").
# CORS_ORIGINS=http://localhost:5173,https://panel.lege.al

# --- Optional ---
HOTEL_NAME=Lege
HOTEL_TZ=Europe/Tirane
PORT=3000
DB_PATH=./data/lege.db

# The "secure" cookie needs HTTPS. It is on by default in production.
# Set it to false ONLY if you test with http://localhost in Docker.
# COOKIE_SECURE=false
# Number of proxies in front of the app (nginx/Caddy = 1). Default in production is 1.
# TRUST_PROXY=1
